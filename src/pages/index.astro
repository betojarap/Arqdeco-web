---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, services, yearsOfExperience } from '../data/site';
const years = yearsOfExperience();
const steps = [
  { title: 'Diagnóstico del local', text: 'Visitamos tu local, revisamos su nivel de riesgo y te decimos qué falta para pasar la inspección.' },
  { title: 'Expediente y planos', text: 'Preparamos planos, memoria descriptiva y los documentos que pide la municipalidad.' },
  { title: 'Obras y equipos', text: 'Ejecutamos las mejoras: instalaciones eléctricas, señalización, extintores, luces de emergencia y rutas de evacuación.' },
  { title: 'Inspección y certificado', text: 'Te acompañamos en la inspección y en el trámite hasta tener tu Certificado ITSE y tu licencia.' },
];
---
<Base preloadImage="/img/portada.webp">
  <section class="hero" style="--hero-img:url(/img/portada.webp)">
    <div class="container">
      <span class="eyebrow" style="color:#b9e07f">Certificado ITSE · Defensa Civil · Licencia de funcionamiento</span>
      <h1>Obtén tu Certificado ITSE y tu licencia de funcionamiento sin observaciones.</h1>
      <p class="lead">Evaluamos tu local, preparamos el expediente y hacemos las obras que pide la inspección: tableros eléctricos, pozo a tierra, señalización, extintores y más. Un solo equipo desde el diagnóstico hasta el certificado.</p>
      <div class="actions">
        <a class="btn" href={site.whatsappItse} target="_blank" rel="noopener">Evalúa tu local por WhatsApp</a>
        <a class="btn ghost" href="/certificado-itse/">Cómo funciona el trámite</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Cómo trabajamos</span>
      <h2>Del diagnóstico al certificado, sin vueltas</h2>
      <div class="steps" style="margin-top:32px">
        {steps.map((st, i) => (
          <div class="step">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{st.title}</h3>
            <p>{st.text}</p>
          </div>
        ))}
      </div>
      <div class="actions"><a class="btn ghost" href="/certificado-itse/" style="color:var(--accent-dark)">Ver el proceso completo</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Qué hacemos</span>
      <h2>Nuestros servicios</h2>
      <p class="lead">Nuestra especialidad es que tu negocio pueda abrir y operar en regla. Además diseñamos, construimos y mantenemos tus espacios.</p>
      <div class="grid grid-3" style="margin-top:32px">
        {services.map((s, i) => (
          <a class="card" href={`/servicios/#${s.id}`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container grid grid-2" style="align-items:stretch">
      <a class="feature" href="/certificado-itse/">
        <Photo src="/img/expediente.webp" alt="Planos y lista de inspección de seguridad sobre un escritorio" ratio="16 / 10" />
        <div>
          <span class="eyebrow">Trámites y licencias</span>
          <h3>Del plano a la licencia</h3>
          <p>Preparamos expedientes técnicos y te acompañamos hasta obtener tu Certificado ITSE y tu licencia de funcionamiento.</p>
        </div>
      </a>
      <a class="feature" href="/servicios/#servicios-generales">
        <Photo src="/img/remodelacion.webp" alt="Oficina corporativa remodelada" ratio="16 / 10" />
        <div>
          <span class="eyebrow">Diseño y construcción</span>
          <h3>Espacios que funcionan</h3>
          <p>Remodelamos oficinas, locales y viviendas con acabados de calidad, desde el diseño hasta la entrega.</p>
        </div>
      </a>
    </div>
  </section>

  <section class="section alt">
    <div class="container grid grid-2">
      <Photo src="/img/quienessomos.webp" alt="Equipo de ingenieros revisando planos en obra" />
      <div>
        <span class="eyebrow">Quiénes somos</span>
        <h2>{site.legalName}</h2>
        <p>Somos una empresa dedicada a la arquitectura, el diseño, la construcción y el mantenimiento de edificaciones. Nuestro objetivo es brindar asesoría personalizada, capacitación e implementación de las normas de seguridad vigentes para edificaciones existentes, de acuerdo con el Reglamento Nacional de Edificaciones.</p>
        <ul class="check-list">
          <li>Tendencias innovadoras en diseño</li>
          <li>Garantía de calidad en cada obra</li>
          <li>Acompañamiento en trámites municipales y de INDECI</li>
        </ul>
        <div class="actions"><a class="btn ghost" href="/nosotros/" style="color:var(--accent-dark)">Conócenos</a></div>
      </div>
    </div>
  </section>

  <section class="section stats-band">
    <div class="container">
      <div class="stats">
        <div class="stat"><strong>{years}+</strong><span>años de experiencia</span></div>
        <div class="stat"><strong>6</strong><span>líneas de servicio</span></div>
        <div class="stat"><strong>24/7</strong><span>soporte técnico en facility management</span></div>
        <div class="stat"><strong>Lima</strong><span>y provincias</span></div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
