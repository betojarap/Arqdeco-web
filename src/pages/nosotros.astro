---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, yearsOfExperience } from '../data/site';
---
<Base title="Nosotros: arquitectura y construcción desde 2012" description="Conoce a ARQDECO PERÚ EIRL: más de una década en arquitectura, construcción, certificados de Defensa Civil y licencias de funcionamiento.">
  <section class="page-hero" style="--hero-img:url(/img/galeria/gal-08.webp)">
    <div class="container">
      <span class="eyebrow" style="color:#b9e07f">Nosotros</span>
      <h1>Más de {yearsOfExperience()} años construyendo confianza</h1>
      <p>Desde 2012 acompañamos a empresas y familias en el diseño, la construcción y la formalización de sus espacios.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2">
      <div>
        <h2>{site.legalName}</h2>
        <p>Fundada en el año 2012, somos una empresa especializada en la asesoría, implementación y trámite del Certificado de Inspección Técnica de Seguridad en Edificaciones (INDECI – Defensa Civil) y de licencias de funcionamiento.</p>
        <p>Además, desarrollamos proyectos de arquitectura, obras civiles, mantenimiento integral y diseño de mobiliario de oficina.</p>
      </div>
      <Photo src="/img/galeria/gal-09.webp" alt="Equipo de Arqdeco en un proyecto" />
    </div>
  </section>

  <section class="section alt">
    <div class="container grid grid-3">
      <div class="card">
        <span class="eyebrow">Misión</span>
        <p>Brindar asesoría personalizada, capacitación e implementación de las normas de seguridad para edificaciones, con soluciones de arquitectura y construcción funcionales, seguras y de calidad.</p>
      </div>
      <div class="card">
        <span class="eyebrow">Visión</span>
        <p>Ser una empresa referente en el Perú en arquitectura, construcción y seguridad en edificaciones, reconocida por la calidad de su trabajo y la confianza de sus clientes.</p>
      </div>
      <div class="card">
        <span class="eyebrow">Valores</span>
        <ul class="check-list">
          <li>Transparencia y honestidad</li>
          <li>Servicio con cortesía</li>
          <li>Solidaridad y respeto</li>
          <li>Responsabilidad ambiental</li>
        </ul>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
