---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, services } from '../data/site';
// Clave pública de Web3Forms: se toma de site.ts (o de la variable PUBLIC_WEB3FORMS_KEY si existe).
const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || site.web3formsKey;
---
<Base title="Contacto" description="Contáctanos por teléfono, WhatsApp o correo. Oficina en Centro Empresarial Panorama, Santiago de Surco, Lima.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" style="color:#b9e07f">Contacto</span>
      <h1>Conversemos sobre tu proyecto</h1>
      <p>Llámanos, escríbenos por WhatsApp o envíanos un mensaje. Te responderemos a la brevedad.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2" style="align-items:start">
      <div>
        <h2>Nuestra oficina</h2>
        <ul class="contact-list">
          <li><Icon name="phone" /><div><strong>Teléfono</strong><a href={site.phoneHref}>{site.phone}</a></div></li>
          <li><Icon name="whatsapp" /><div><strong>WhatsApp</strong><a href={site.whatsapp} target="_blank" rel="noopener">Escríbenos ahora</a></div></li>
          <li><Icon name="mail" /><div><strong>Correo</strong><a href={`mailto:${site.email}`}>{site.email}</a></div></li>
          <li><Icon name="pin" /><div><strong>Dirección</strong><a href={site.mapsUrl} target="_blank" rel="noopener">{site.address}</a></div></li>
        </ul>
      </div>

      <div class="card">
        <h2 style="font-size:1.5rem">Solicita una cotización</h2>
        <form class="form" id="contact-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value={formKey} />
          <input type="hidden" name="subject" value="Nuevo mensaje desde arqdeco.com.pe" />
          <input type="hidden" name="from_name" value="Web Arqdeco" />
          <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />
          <div class="row">
            <label>Nombre<input name="name" required autocomplete="name" /></label>
            <label>Teléfono<input name="phone" type="tel" autocomplete="tel" /></label>
          </div>
          <label>Correo electrónico<input name="email" type="email" required autocomplete="email" /></label>
          <label>Servicio de interés
            <select name="servicio">
              <option value="">Selecciona una opción</option>
              {services.map((s) => <option>{s.title}</option>)}
              <option>Facility management</option>
              <option>Otro</option>
            </select>
          </label>
          <label>Mensaje<textarea name="message" rows="5" required></textarea></label>
          <button class="btn" type="submit">Enviar mensaje</button>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = form?.querySelector('.form-status');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;
    const data = new FormData(form);
    if (!data.get('access_key')) {
      status.textContent = 'El formulario aún no está activado. Escríbenos por WhatsApp o correo.';
      return;
    }
    status.textContent = 'Enviando…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      const json = await res.json();
      if (json.success) {
        form.reset();
        status.textContent = '¡Gracias! Recibimos tu mensaje y te responderemos pronto.';
      } else {
        status.textContent = 'No se pudo enviar. Intenta de nuevo o escríbenos por WhatsApp.';
      }
    } catch {
      status.textContent = 'No se pudo enviar. Intenta de nuevo o escríbenos por WhatsApp.';
    }
  });
</script>
