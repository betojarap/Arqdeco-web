// Configuración de Cloudflare Workers: publica la carpeta dist/ (sitio estático).
// Sin este archivo Cloudflare no puede generar las vistas previas de las ramas.
{
  "name": "arqdeco-web",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "preview_urls": true,
  // Necesario para `npx wrangler preview`, el comando que usa Cloudflare en las ramas de prueba.
  "previews": {}
}
